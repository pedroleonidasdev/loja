[Unit]
Description=Agente HTTP local de impressao (cupom na Goldensky, etiquetas na Elgin)
After=network.target cups.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/goldensky-agente.py
Environment=GOLDENSKY_AGENTE_HOST=127.0.0.1
Environment=GOLDENSKY_AGENTE_PORT=9100
# Goldensky 80mm = SOMENTE cupom não fiscal (fila CUPS abaixo).
Environment=GOLDENSKY_CUPS_QUEUE=Goldensky-80
# Elgin L42 Pro Full = SOMENTE etiquetas de preço (ZPL).
Environment=ETIQUETA_DRIVER=zpl
Environment=ELGIN_TRANSPORTE=cups
Environment=ELGIN_CUPS_QUEUE=Elgin-L42
# ou, se a Elgin estiver na rede (Ethernet), troque as 2 linhas acima por:
#Environment=ELGIN_TRANSPORTE=tcp
#Environment=ELGIN_HOST=192.168.0.50
Restart=on-failure
RestartSec=3
# roda como usuário sem privilégio, mas precisa poder chamar `lp` (grupo lp/lpadmin)
User=goldensky-agente
SupplementaryGroups=lp lpadmin

[Install]
WantedBy=multi-user.target
