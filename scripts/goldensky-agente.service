[Unit]
Description=Agente HTTP local de impressao (cupom na Goldensky, etiquetas na Elgin)
After=network.target cups.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/goldensky-agente.py
Environment=GOLDENSKY_AGENTE_HOST=127.0.0.1
Environment=GOLDENSKY_AGENTE_PORT=9100
# Goldensky 80mm = SOMENTE cupom não fiscal (fila CUPS abaixo).
Environment=GOLDENSKY_CUPS_QUEUE=Goldensky-80
# Elgin L42 Pro Full = SOMENTE etiquetas de preço (ZPL).
Environment=ELGIN_TRANSPORTE=cups
Environment=ELGIN_CUPS_QUEUE=Elgin-L42
# ou, se a Elgin estiver na rede (Ethernet), troque as 2 linhas acima por:
#Environment=ELGIN_TRANSPORTE=tcp
#Environment=ELGIN_HOST=10.50.1.175
# (10.50.1.175 = IP que a Elgin da loja recebeu por DHCP no relatório de configuração. Como é DHCP, o IP
#  pode mudar: reserve esse IP no roteador ou configure um IP fixo na impressora antes de usar tcp.)
# Bobina DUPLA (2 etiquetas lado a lado, ex.: 2 x 40x25mm): 2 colunas, gap entre elas em mm.
# Meça o espaço entre as duas colunas na bobina e ajuste GAP (normalmente 2 a 3 mm).
Environment=ELGIN_COLUNAS=2
Environment=ELGIN_GAP_COLUNAS_MM=3
# Se a coluna da esquerda sair cortada / tudo deslocado, ajuste (mm, pode ser 1, 2...):
#Environment=ELGIN_OFFSET_X_MM=0
# Método de impressão: por padrão vale o que está gravado na impressora (TRANSF.TERMICA). Para forçar:
#Environment=ELGIN_METODO=transferencia
Restart=on-failure
RestartSec=3
# roda como usuário sem privilégio, mas precisa poder chamar `lp` (grupo lp/lpadmin)
User=goldensky-agente
SupplementaryGroups=lp lpadmin

[Install]
WantedBy=multi-user.target
